{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id", "core_claim", "period", "location",
    "primary_sources", "documented_facts",
    "reconstructed_elements", "asset_licenses"
  ],
  "properties": {
    "episode_id": { "type": "string" },
    "core_claim": { "type": "string", "minLength": 20 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_year", "end_year"],
      "properties": {
        "start_year": { "type": "integer" },
        "end_year": { "type": "integer" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country"],
      "properties": {
        "city": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "key_dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event", "source_id"],
        "properties": {
          "date": { "type": "string" },
          "event": { "type": "string" },
          "source_id": { "type": "string" }
        }
      }
    },
    "named_figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "source_id"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "source_id": { "type": "string" }
        }
      }
    },
    "primary_sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "institution", "url", "priority"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "institution": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "priority": { "type": "integer", "enum": [1, 2] },
          "quote_or_excerpt": {
            "type": "string",
            "description": "Optional. Verbatim quotation or close excerpt from the source. Never invent quotations; omit if no verbatim text exists."
          }
        }
      }
    },
    "secondary_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "url", "priority"],
        "properties": {
          "source_id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "priority": { "type": "integer", "enum": [3, 4] }
        }
      }
    },
    "documented_facts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "source_id"],
        "properties": {
          "fact": { "type": "string" },
          "source_id": { "type": "string" }
        }
      }
    },
    "reconstructed_elements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "composite_characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "based_on", "disclosure"],
        "properties": {
          "label": { "type": "string" },
          "based_on": { "type": "string" },
          "disclosure": { "type": "string" }
        }
      }
    },
    "asset_licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_url", "license", "attribution_required"],
        "properties": {
          "asset_url": { "type": "string", "format": "uri" },
          "license": { "type": "string" },
          "attribution_required": { "type": "boolean" }
        }
      }
    }
  }
}
